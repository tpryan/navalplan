{
  "criteria": {
    "rubric_based_final_response_quality_v1": {
      "threshold": 0.8,
      "judge_model_options": {
        "judge_model": "gemini-2.0-flash",
        "num_samples": 1
      },
      "rubrics": [
        {
          "rubric_id": "summary_contains_location",
          "rubric_content": {
            "text_property": "The final response summary mentions the location (e.g. BVI, British Virgin Islands) provided in the prompt."
          }
        },
        {
          "rubric_id": "search_suggestions_present",
          "rubric_content": {
            "text_property": "The response includes evidence of a web search, such as grounding links or search suggestions."
          }
        },
        {
          "rubric_id": "json_format",
          "rubric_content": {
            "text_property": "The response is a valid JSON object."
          }
        }
      ]
    }
  }
}
