# NavalPlan Configuration

# Database
# NAVALPLAN_DATABASE_URL=postgres://navalplan_user:navalplan_pass@localhost:5433/navalplan?sslmode=disable
NAVALPLAN_DB_HOST=localhost
NAVALPLAN_DB_PORT=5433
NAVALPLAN_DB_USER=navalplan_user
NAVALPLAN_DB_PASS=navalplan_pass
NAVALPLAN_DB_NAME=navalplan
NAVALPLAN_DB_MODE=disable

NAVALPLAN_PORT=8080

# Google OAuth (Required for Login)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Environment (development/production)
ENV=development

# Agent Model (Optional)
# NAVALPLAN_AGENT_MODEL=gemini-2.0-flash-001

# Google Maps (Required)
# Create separate keys if you want to restrict them differently (e.g., Frontend restricted by Referrer, Backend restricted by IP)
NAVALPLAN_FRONTEND_MAPS_API_KEY=your-frontend-google-maps-key
NAVALPLAN_BACKEND_MAPS_API_KEY=your-backend-google-maps-key

# Gemini (Required for Agent)
GEMINI_API_KEY=your-gemini-api-key

# System (Required for Cloud Scheduler)
NAVALPLAN_SYSTEM_KEY=your-secret-system-key
