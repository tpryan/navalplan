# NavalPlan Configuration

# Database
# NAVALPLAN_DATABASE_URL=postgres://navalplan_user:navalplan_pass@localhost:5433/navalplan?sslmode=disable
NAVALPLAN_DB_HOST=localhost
NAVALPLAN_DB_PORT=5433
NAVALPLAN_DB_USER=navalplan_user
NAVALPLAN_DB_PASS=navalplan_pass
NAVALPLAN_DB_NAME=navalplan
NAVALPLAN_DB_MODE=disable

NAVALPLAN_PORT=8080

# Google OAuth (Required for Login)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Environment (development/production)
ENV=development

# Agent Model (Optional)
# NAVALPLAN_AGENT_MODEL=gemini-3.5-flash-lite
# NAVALPLAN_AGENT_BASE_URL=http://localhost:8081
# Reasoning tokens per LLM call. Lower = faster/cheaper. 0 disables thinking,
# -1 restores the model's dynamic (unbounded) budget. Default: 1024.
# NAVALPLAN_AGENT_THINKING_BUDGET=1024
# Per-query timeout (ms) for grounded web searches so one slow query can't stall
# the parallel batch. 0 disables the bound. Default: 45000.
# NAVALPLAN_AGENT_SEARCH_TIMEOUT_MS=45000

# Google Maps (Required)
# Create separate keys if you want to restrict them differently (e.g., Frontend restricted by Referrer, Backend restricted by IP)
NAVALPLAN_FRONTEND_MAPS_API_KEY=your-frontend-google-maps-key
NAVALPLAN_BACKEND_MAPS_API_KEY=your-backend-google-maps-key
NAVALPLAN_MAP_ID=your-map-id
NAVALPLAN_MAP_ID_MM=your-midnight-mariner-map-id

# Gemini (Required for Agent)
GEMINI_API_KEY=your-gemini-api-key

# Tidal APIs (Optional — enables regional providers for UK/Ireland and New Zealand)
# NAVALPLAN_TIDAL_UKTIDAL_API_KEY=your-admiralty-uk-tidal-key
# NAVALPLAN_TIDAL_NIWA_API_KEY=your-niwa-key

# Nautical RAG / Vertex AI Publications (Enables official Coast Pilot & Sailing Directions in dev)
# GOOGLE_CLOUD_PROJECT=navallog
# VERTEX_LOCATION=us-central1
# COAST_PILOT_CORPUS_ID=coast-pilot-corpus
# NGA_CORPUS_ID=nga-sailing-directions-corpus

# System (Required for Cloud Scheduler)
NAVALPLAN_SYSTEM_KEY=your-secret-system-key

